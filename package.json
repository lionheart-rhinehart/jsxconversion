{
  "name": "aa-creative-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Athletes Acceleration creative engine — generates branded ad videos and statics from JSX templates.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "edit": "node scripts/edit.mjs",
    "restart": "node scripts/restart-dev.mjs",
    "dev:editor": "node --watch scripts/editor-server.mjs",
    "dev:review": "node --watch brand/video-templates/serve.mjs",
    "render": "node creative-engine-v1/jsx-to-mp4/scripts/render.mjs",
    "jsx-to-mp4-conversion": "node scripts/jsx-to-mp4-conversion.mjs",
    "validate-templates": "node scripts/validate-templates.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepare": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "esbuild": "^0.24.0",
    "node-html-parser": "^7.1.0",
    "puppeteer": "^23.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@remotion/cli": "^4.0.0",
    "framer-motion": "^11.0.0",
    "remotion": "^4.0.0"
  }
}
