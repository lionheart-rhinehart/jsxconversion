%); }\n}\n@keyframes cFlipA { \n  0%, 38%, 100% { opacity: 1; }\n  50%, 88% { opacity: 0; }\n}\n@keyframes cFlipB { \n  0%, 38%, 100% { opacity: 0; }\n  50%, 88% { opacity: 1; }\n}\n@keyframes cRing { \n  0%, 100% { stroke-dashoffset: 0; }\n  48% { stroke-dashoffset: var(--clen, 1583); }\n}\n@keyframes cKnob { \n  0%, 100% { transform: translateX(var(--kx, 74px)); }\n  50% { transform: translateX(0px); }\n}\n@keyframes cRipple { \n  0% { transform: scale(0.4); opacity: 0.5; }\n  70%, 100% { transform: scale(3.2); opacity: 0; }\n}\n@keyframes cStamp { \n  0%, 100% { transform: scale(1) rotate(-9deg); opacity: 1; }\n  44% { transform: scale(1.7) rotate(-9deg); opacity: 0; }\n  56% { opacity: 0; }\n}\n@keyframes cRise { \n  0%, 12%, 100% { transform: translateY(0px); opacity: 1; }\n  50% { transform: translateY(40px); opacity: 0; }\n}\n",
