node_modules/
out/*
# The position editor is source, not a rendered artifact — keep it tracked.
# (Use out/* above, not out/, so this subdirectory can be re-included.)
!out/editor/
.tmp/
# Filled template variants are generated scratch (data → render proof), not source.
templates/**/*.fill.config.json
templates/**/*.fill.jsx
# Per-cell campaign render variants (from run-campaign.mjs)
templates/**/*.camp-*
brand/video-templates/_camp-*
brand/video-templates/__render/
# Per-example staging scratch for staged brand-motion video examples (stage-motion.mjs):
# the wrapper + copied runtime (animations/editing/elements) render here; only the
# resulting <id>.mp4 + <id>.png get copied into templates/_examples/ and committed.
templates/_examples/_staging/
templates/_examples/**/*.bgframes/
# Raw media pulled from The Kraken Content Library (local cache, not source)
brand/kraken-cache/
# Kraken photos swapped into static templates via /media-into-template (client media)
templates/**/assets/swap-*
# Per-checkout dev server ports (written by scripts/dev.mjs; machine-local)
.dev-ports.json
# Editor template-root overrides (written by scripts/edit.mjs; machine-local)
.editor-config.json
# Plan-execution checklist read by the Stop "foreman" hook (per-session, machine-local; never source)
.active-plan*.json
*.log
.DS_Store
__render/
.claude/settings.local.json
# Scheduled-tasks runtime lock (machine-local, churns; not source)
.claude/scheduled_tasks.lock
# Zone-protection auto-backups (machine-local, created by the protection hook)
.backups/
# Generated compliance reports (regenerated by validate-plan.mjs / run-campaign.mjs).
# The validation.config.json OVERRIDES are config and ARE tracked; the reports are not.
campaigns/**/validation.json
# Perceptual gate output + intermediates (regenerated by perceptual-sidecar.mjs from the
# machine-local renders; like validation.json, derived + not source).
campaigns/**/perceptual.json
campaigns/**/.perceptual-*
# Generated intake parse report (regenerated by intake-copy.mjs).
campaigns/**/copy-library.report.json
# AA weekly-birthday transient render scratch (render.mjs cleans these; ignore crash stragglers)
automation/.render-*

# Waveform peaks cache (machine-local, A2 audio picker)
.peaks-cache/

# Review-markup sidecar store (Feature 2 — machine-local)
.annotations-store/
